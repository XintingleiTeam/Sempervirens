#include <winver.h>
#pragma code_page(65001)

1 ICON "sempervirens.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "XintingleiTeam"
            VALUE "FileDescription", "Sempervirens Update Service"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "SempervirensUpdater"
            VALUE "OriginalFilename", "SempervirensUpdater.exe"
            VALUE "ProductName", "Sempervirens"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
