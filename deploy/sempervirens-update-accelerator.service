[Unit]
Description=Sempervirens GitHub release accelerator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /opt/sempervirens-update/update_accelerator.py --listen 127.0.0.1 --port 18181 --cache /var/cache/sempervirens-update
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/sempervirens-update

[Install]
WantedBy=multi-user.target
